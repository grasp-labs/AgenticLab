<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticLab.ServiceDefaults\AgenticLab.ServiceDefaults.csproj" />
    <ProjectReference Include="..\AgenticLab.Extensibility\AgenticLab.Extensibility.csproj" />
    <ProjectReference Include="..\AgenticLab.Examples.Copilot365\AgenticLab.Examples.Copilot365.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgenticLab.Web.Tests" />
  </ItemGroup>

  <!-- Learning-panel content: per-concept folders (meta.json + body.md) copied next to the app. -->
  <ItemGroup>
    <Content Update="Concepts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
