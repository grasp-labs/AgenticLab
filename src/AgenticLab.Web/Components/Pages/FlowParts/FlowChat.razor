@inject IJSRuntime JS
<section class="chat-controls" aria-label="Messages">
    <div class="chat-log" @ref="_logRef">
        @if (Run.Turns.Count == 0 && string.IsNullOrWhiteSpace(Run.RunMessage))
        {
            <div class="chat-empty">
                <p>No messages yet.</p>
                @if (View.Agent.SuggestedPrompts.Count > 0 && string.IsNullOrWhiteSpace(View.Message))
                {
                    <div class="chat-suggestions" role="group" aria-label="Suggested messages">
                        <span class="chat-suggestions-label">Try asking</span>
                        @foreach (var prompt in View.Agent.SuggestedPrompts)
                        {
                            <LabButton Label="@prompt" Variant="secondary" Disabled="@Run.Running"
                                       OnClick="@(() => View.Message = prompt)" />
                        }
                    </div>
                }
            </div>
        }
        else
        {
            @foreach (var turn in Run.Turns)
            {
                <div class="turn" @key="turn">
                    <article class="entry user">
                        <header class="entry-head"><span class="role">You</span></header>
                        <p>@turn.Message</p>
                    </article>
                    <article class="entry agent @(string.IsNullOrWhiteSpace(turn.Error) ? "" : "failed")">
                        <header class="entry-head"><span class="role">@(turn.Agent ?? "Agent")</span></header>
                        @if (!string.IsNullOrWhiteSpace(turn.Error))
                        {
                            <p class="error">@turn.Error</p>
                        }
                        else
                        {
                            <p>@turn.Reply</p>
                        }
                        <TokenUsageFooter ExchangeId="@turn.Id" />
                    </article>
                </div>
            }

            @* The current/most-recent exchange. It lives in RunMessage/Reply until the next send archives
               it into Turns, so render it here for both the in-progress run and the just-finished one. *@
            @if (!string.IsNullOrWhiteSpace(Run.RunMessage))
            {
                <div class="turn pending">
                    <article class="entry user">
                        <header class="entry-head"><span class="role">You</span></header>
                        <p>@Run.RunMessage</p>
                    </article>
                    <article class="entry agent @(Run.Status.Activity == AgentActivity.Failed ? "failed" : "")">
                        <header class="entry-head">
                            <span class="role">@(View.SelectedAgent ?? "Agent")</span>
                            @if (Run.Status.AgentStatusLabel is { } status)
                            {
                                <LabStatus Label="@status" Tone="@StatusTone" Busy="@StatusBusy" />
                            }
                            @if (Run.Status.TurnMeta is { } meta)
                            {
                                <span class="turn-meta @(Run.Focus.LoopActive ? "live" : "")">@meta</span>
                            }
                        </header>
                        @if (!string.IsNullOrWhiteSpace(Run.Error))
                        {
                            <p class="error">@Run.Error</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(Run.Reply))
                        {
                            <p>@Run.Reply</p>
                        }
                        @if (Run.Status.AgentStatusNote is { } note)
                        {
                            <p class="status-note">@note</p>
                        }
                        <TokenUsageFooter ExchangeId="@Run.RunExchangeId" />
                    </article>
                </div>
            }
        }
    </div>

    @if (Run.AwaitingAnswer)
    {
        <div class="control message ask-question">
            <label for="answer">The agent is asking</label>
            <p class="ask-question-text">@Run.PendingQuestion</p>
            <div class="ask-question-row">
                <input id="answer" @bind="Run.AnswerText" @bind:event="oninput"
                       placeholder="Type your answer…" @onkeydown="OnAnswerKeyDownAsync" />
                <LabButton Label="Send your answer" Icon="send" IconOnly="true" Variant="primary"
                       OnClick="Run.SubmitAnswerAsync" Disabled="@string.IsNullOrWhiteSpace(Run.AnswerText)" />
            </div>
        </div>
    }

    <div class="chat-composer">
        <div class="control message">
            <label for="message">Message</label>
            <textarea id="message" rows="3" data-enter-submit @bind="View.Message" @bind:event="oninput"
                      placeholder="Message the agent..."
                      disabled="@Run.Running" @onkeydown="OnKeyDownAsync"></textarea>
        </div>

        <div class="composer-actions">
            <span class="send-action">
                <LabButton Label="Send" Icon="send" IconOnly="true" Variant="primary" OnClick="Run.SendAsync"
                           Disabled="@(Run.Running || string.IsNullOrWhiteSpace(View.Message) || (View.Agent.RequiresWorkspace && string.IsNullOrWhiteSpace(View.Workspace)))" />
            </span>
        </div>

        @if (Run.Status.ComposerHint is { } hint)
        {
            <p class="composer-hint">@hint</p>
        }
    </div>
</section>

@code {
    private ElementReference _logRef;

    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    private string StatusTone => Run.Status.Activity switch
    {
        AgentActivity.Failed => "danger",
        AgentActivity.AwaitingAnswer or AgentActivity.Paused or AgentActivity.AwaitingStep or AgentActivity.AtBreakpoint => "warning",
        _ => "success",
    };

    private bool StatusBusy => Run.Running && StatusTone == "success";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keep the newest message in view as the conversation grows / the reply streams in, unless the
        // user has scrolled up to read earlier messages (handled by stickToBottom in panels.js).
        try
        {
            await JS.InvokeVoidAsync("agenticLabPanels.stickToBottom", _logRef);
        }
        catch
        {
            // JS may be unavailable during prerender; the next interactive render scrolls.
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        // Enter sends; Shift+Enter inserts a new line (the textarea handles the newline, while a
        // small guard in panels.js suppresses the newline for a plain Enter that we send on).
        if (args.Key == "Enter" && !args.ShiftKey && !Run.Running && !string.IsNullOrWhiteSpace(View.Message))
        {
            await Run.SendAsync();
        }
    }

    private async Task OnAnswerKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && Run.AwaitingAnswer && !string.IsNullOrWhiteSpace(Run.AnswerText))
        {
            await Run.SubmitAnswerAsync();
        }
    }
}
