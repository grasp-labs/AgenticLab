<nav class="vendor-rail" aria-label="Host">
    @foreach (var host in View.Roster.AvailableHosts)
    {
        var active = host.Key == View.HostKey;
        var presentation = View.Roster.PresentationFor(host.Key);

        <div class="rail-item @(active ? "active" : "")">
            <button type="button" class="rail-icon" aria-label="@host.DisplayName" aria-pressed="@(active ? "true" : "false")"
                    disabled="@Run.Running" @onclick="@(() => SelectAsync(host.Key))">
                <VendorIcon IconPath="@presentation?.IconPath" />
            </button>
            <div class="rail-tooltip" role="tooltip">
                <span class="rt-name">@host.DisplayName</span>
                <span class="rt-model">@View.Harness.HostModelLabel(host)</span>
                <span class="rt-modes">@host.Modes.Count mode@(host.Modes.Count == 1 ? "" : "s")</span>
                @if (presentation?.ProductConceptId is { } conceptId)
                {
                    <ConceptInfoButton Id="@conceptId" Title="@($"Learn about {host.DisplayName}")" />
                }
            </div>
        </div>
        @if (host.Key == "default" && View.Roster.AvailableHosts.Count > 1)
        {
            <div class="rail-divider" aria-hidden="true"></div>
        }
    }
</nav>

@code {
    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    /// <summary>Raised when the user picks a vendor; the page persists it and refreshes the agent roster.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnSelectVendor { get; set; }

    private async Task SelectAsync(string key)
    {
        if (key != View.HostKey && !Run.Running)
        {
            await OnSelectVendor.InvokeAsync(key);
        }
    }
}
