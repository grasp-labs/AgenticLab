<header class="app-header">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true"><span></span></span>
        <h1>@Title</h1>
    </div>
    <div class="header-actions">
        <span class="edition">@Context <span>Blazor</span></span>
        @ChildContent
        @if (_userName is { } userName)
        {
            <span class="header-user" title="Signed in with Microsoft Entra ID">@userName</span>
            <a class="header-link" href="@EntraSignIn.SignOutHref" data-enhance-nav="false">Sign out</a>
        }
        <RepositoryLink />
    </div>
</header>

@code {
    /// <summary>The page's existing product heading, independent of navigation and run state.</summary>
    [Parameter] public string Title { get; set; } = "Agentic AI";
    /// <summary>A compact page identifier next to the implementation label.</summary>
    [Parameter, EditorRequired] public string Context { get; set; } = string.Empty;
    /// <summary>Page-specific links and actions, rendered inside the page's interactive boundary.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The sign-in state when Entra sign-in is configured; absent or anonymous otherwise.</summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? _userName;

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        _userName = user?.Identity?.IsAuthenticated == true ? user.Identity.Name ?? "Signed in" : null;
    }
}