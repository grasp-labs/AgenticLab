# Local configuration for Agentic Lab. Copy to .env (git- and Docker-ignored) and fill in one provider.
# AppHost (`dotnet run --project src/AgenticLab.AppHost`) reads every key. `docker compose` passes only the
# provider, AWS_* and Examples__copilot365__Enabled keys listed in docker-compose.yml (not Agents__* settings).
# Keys use environment-variable form: `__` separates sections (Bedrock__ApiKey = Bedrock:ApiKey).
# Blank values are ignored. Real environment variables and command-line arguments take precedence.
# Values are literal: no $VAR expansion or escape sequences (keep them out of keys to match Compose).

# Model provider: AzureOpenAI (default), OpenAI, Gemini or Bedrock. Left blank, other sources decide.
Models__Provider=

# Amazon Bedrock: region, model or inference profile ID, and either an API key or AWS credentials.
Bedrock__Region=
Bedrock__Model=
Bedrock__ApiKey=
# Bedrock__Profile=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Azure OpenAI
# AzureOpenAI__Endpoint=
# AzureOpenAI__Deployment=
# AzureOpenAI__ApiKey=

# OpenAI
# OpenAI__Model=
# OpenAI__ApiKey=

# Gemini
# Gemini__Model=
# Gemini__ApiKey=

# Optional Microsoft Entra ID sign-in for Web: only users of this tenant can open the app.
# Register /signin-oidc and /signout-callback-oidc on http://localhost:5140 (Aspire) and/or
# http://localhost:8080 (Docker) as Web redirect URIs, and create a client secret under Certificates & secrets.
# AzureAd__TenantId=
# AzureAd__ClientId=
# AzureAd__ClientSecret=

# Examples: copilot365 is on by default in AppHost Development and in docker compose.
# Examples__copilot365__Enabled=false
