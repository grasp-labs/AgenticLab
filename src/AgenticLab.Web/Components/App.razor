<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@($"{HttpContext?.Request.PathBase}/")" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["design-system.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AgenticLab.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/panels.js"]"></script>
</body>

</html>

@code {
    // The path base (see PathBase.cs) makes relative links, assets and the Blazor circuit stay under the prefix.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
}
